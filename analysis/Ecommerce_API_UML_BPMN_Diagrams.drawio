<mxfile host="app.diagrams.net" modified="2026-11-11T16:00:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="637f655f-" name="01 - UML Use Case"><mxGraphModel dx="1300" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1860" pageHeight="1160" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="UML Use Case — E-Commerce API v1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#1f3349;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1000" height="44" as="geometry" /></mxCell><mxCell id="3" value="Public visitors can browse products. Registered customers manage carts and pay in USD. One administrator manages the catalog. Stripe is an external payment actor." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9e8;strokeColor=#dbbc67;fontColor=#6a5420;fontSize=13;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="30" y="68" width="1760" height="55" as="geometry" /></mxCell><mxCell id="4" value="E-Commerce API — System boundary" style="swimlane;startSize=38;html=1;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#73889e;fontSize=20;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="235" y="165" width="1310" height="895" as="geometry" /></mxCell><mxCell id="5" value="Visitor" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;strokeColor=#253d56;fillColor=#e9f0f9;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="90" height="110" as="geometry" /></mxCell><mxCell id="6" value="Customer" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;strokeColor=#253d56;fillColor=#e9f0f9;fontSize=15;" vertex="1" parent="1"><mxGeometry x="55" y="565" width="100" height="110" as="geometry" /></mxCell><mxCell id="7" value="Administrator" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;strokeColor=#253d56;fillColor=#e9f0f9;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1665" y="365" width="110" height="110" as="geometry" /></mxCell><mxCell id="8" value="Stripe" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;strokeColor=#253d56;fillColor=#e9f0f9;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1665" y="760" width="100" height="100" as="geometry" /></mxCell><mxCell id="9" value="Browse products" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#638bb3;fontColor=#233f5c;fontSize=13;" vertex="1" parent="1"><mxGeometry x="320" y="250" width="195" height="70" as="geometry" /></mxCell><mxCell id="10" value="View product details" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#638bb3;fontColor=#233f5c;fontSize=13;" vertex="1" parent="1"><mxGeometry x="320" y="365" width="195" height="70" as="geometry" /></mxCell><mxCell id="11" value="Search by name" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#638bb3;fontColor=#233f5c;fontSize=13;" vertex="1" parent="1"><mxGeometry x="320" y="480" width="195" height="70" as="geometry" /></mxCell><mxCell id="12" value="Register customer" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#638bb3;fontColor=#233f5c;fontSize=13;" vertex="1" parent="1"><mxGeometry x="650" y="245" width="195" height="70" as="geometry" /></mxCell><mxCell id="13" value="Log in" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#638bb3;fontColor=#233f5c;fontSize=13;" vertex="1" parent="1"><mxGeometry x="650" y="360" width="195" height="70" as="geometry" /></mxCell><mxCell id="14" value="Log out (client-side)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#638bb3;fontColor=#233f5c;fontSize=13;" vertex="1" parent="1"><mxGeometry x="650" y="475" width="195" height="70" as="geometry" /></mxCell><mxCell id="15" value="Manage cart" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#638bb3;fontColor=#233f5c;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="595" width="195" height="70" as="geometry" /></mxCell><mxCell id="16" value="Checkout and reserve stock" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#638bb3;fontColor=#233f5c;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1015" y="580" width="195" height="70" as="geometry" /></mxCell><mxCell id="17" value="Pay for order" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#638bb3;fontColor=#233f5c;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1015" y="720" width="195" height="70" as="geometry" /></mxCell><mxCell id="18" value="View order status" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#638bb3;fontColor=#233f5c;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1015" y="840" width="195" height="70" as="geometry" /></mxCell><mxCell id="19" value="Manage products" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#638bb3;fontColor=#233f5c;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1335" y="255" width="175" height="70" as="geometry" /></mxCell><mxCell id="20" value="Manage prices" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#638bb3;fontColor=#233f5c;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1335" y="370" width="175" height="70" as="geometry" /></mxCell><mxCell id="21" value="Manage stock" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#638bb3;fontColor=#233f5c;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1335" y="485" width="175" height="70" as="geometry" /></mxCell><mxCell id="22" value="" style="endArrow=none;html=1;strokeColor=#526478;" edge="1" parent="1" source="5" target="9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="23" value="" style="endArrow=none;html=1;strokeColor=#526478;" edge="1" parent="1" source="5" target="10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="24" value="" style="endArrow=none;html=1;strokeColor=#526478;" edge="1" parent="1" source="5" target="11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="25" value="" style="endArrow=none;html=1;strokeColor=#526478;" edge="1" parent="1" source="5" target="12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="26" value="" style="endArrow=none;html=1;strokeColor=#526478;" edge="1" parent="1" source="5" target="13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="27" value="" style="endArrow=none;html=1;strokeColor=#526478;" edge="1" parent="1" source="6" target="13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="28" value="" style="endArrow=none;html=1;strokeColor=#526478;" edge="1" parent="1" source="6" target="14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="29" value="" style="endArrow=none;html=1;strokeColor=#526478;" edge="1" parent="1" source="6" target="15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="30" value="" style="endArrow=none;html=1;strokeColor=#526478;" edge="1" parent="1" source="6" target="16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="31" value="" style="endArrow=none;html=1;strokeColor=#526478;" edge="1" parent="1" source="6" target="17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="32" value="" style="endArrow=none;html=1;strokeColor=#526478;" edge="1" parent="1" source="6" target="18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="33" value="" style="endArrow=none;html=1;strokeColor=#526478;" edge="1" parent="1" source="7" target="13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="34" value="" style="endArrow=none;html=1;strokeColor=#526478;" edge="1" parent="1" source="7" target="19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="35" value="" style="endArrow=none;html=1;strokeColor=#526478;" edge="1" parent="1" source="7" target="20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="36" value="" style="endArrow=none;html=1;strokeColor=#526478;" edge="1" parent="1" source="7" target="21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="37" value="" style="endArrow=none;html=1;strokeColor=#526478;" edge="1" parent="1" source="8" target="17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="38" value="«include»" style="endArrow=open;dashed=1;dashPattern=4 4;html=1;strokeColor=#777;" edge="1" parent="1" source="16" target="17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="39" value="Customer and administrator share the login mechanism but have different permissions. Public registration creates Customer accounts only." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9e8;strokeColor=#dbbc67;fontColor=#6a5420;fontSize=13;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="260" y="1080" width="1250" height="54" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="6f57bb54-" name="02 - UML Domain Class"><mxGraphModel dx="1300" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1860" pageHeight="1170" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="UML Domain Class — Data Entities and Associations" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#1f3349;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1000" height="44" as="geometry" /></mxCell><mxCell id="3" value="Conceptual class model (not API DTOs). Multiplicities represent typical v1 records; an OrderItem snapshots its USD unit price." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9e8;strokeColor=#dbbc67;fontColor=#6a5420;fontSize=13;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="30" y="65" width="1770" height="55" as="geometry" /></mxCell><mxCell id="4" value="&lt;b&gt;User&lt;/b&gt;&lt;hr&gt;+ id: UUID&lt;br&gt;+ fullName: string&lt;br&gt;+ email: string {unique}&lt;br&gt;+ passwordHash: string&lt;br&gt;+ role: Customer | Administrator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff5ff;strokeColor=#6f98ca;fontColor=#20364f;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="45" y="175" width="285" height="215" as="geometry" /></mxCell><mxCell id="5" value="&lt;b&gt;Cart&lt;/b&gt;&lt;hr&gt;+ id: UUID&lt;br&gt;+ customerId: UUID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff5ff;strokeColor=#6f98ca;fontColor=#20364f;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="420" y="170" width="240" height="145" as="geometry" /></mxCell><mxCell id="6" value="&lt;b&gt;CartItem&lt;/b&gt;&lt;hr&gt;+ cartId: UUID&lt;br&gt;+ productId: UUID&lt;br&gt;+ quantity: int" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff5ff;strokeColor=#6f98ca;fontColor=#20364f;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="735" y="160" width="255" height="155" as="geometry" /></mxCell><mxCell id="7" value="&lt;b&gt;Product&lt;/b&gt;&lt;hr&gt;+ id: UUID&lt;br&gt;+ name: string&lt;br&gt;+ category: string&lt;br&gt;+ description: string&lt;br&gt;+ priceUSD: decimal&lt;br&gt;+ stockQuantity: int&lt;br&gt;+ active: boolean&lt;br&gt;+ imageURL?: string" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff5ff;strokeColor=#6f98ca;fontColor=#20364f;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1110" y="165" width="305" height="285" as="geometry" /></mxCell><mxCell id="8" value="&lt;b&gt;Order&lt;/b&gt;&lt;hr&gt;+ id: UUID&lt;br&gt;+ customerId: UUID&lt;br&gt;+ status: enum&lt;br&gt;+ totalUSD: decimal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff5ff;strokeColor=#6f98ca;fontColor=#20364f;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="45" y="605" width="280" height="180" as="geometry" /></mxCell><mxCell id="9" value="&lt;b&gt;OrderItem&lt;/b&gt;&lt;hr&gt;+ orderId: UUID&lt;br&gt;+ productId: UUID&lt;br&gt;+ quantity: int&lt;br&gt;+ unitPriceUSD: decimal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff5ff;strokeColor=#6f98ca;fontColor=#20364f;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="430" y="595" width="285" height="180" as="geometry" /></mxCell><mxCell id="10" value="&lt;b&gt;StockReservation&lt;/b&gt;&lt;hr&gt;+ orderId: UUID&lt;br&gt;+ productId: UUID&lt;br&gt;+ quantity: int&lt;br&gt;+ expiresAt: timestamp&lt;br&gt;+ status: enum" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff5ff;strokeColor=#6f98ca;fontColor=#20364f;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="810" y="600" width="295" height="195" as="geometry" /></mxCell><mxCell id="11" value="&lt;b&gt;PaymentAttempt&lt;/b&gt;&lt;hr&gt;+ id: UUID&lt;br&gt;+ orderId: UUID&lt;br&gt;+ gatewayReference: string&lt;br&gt;+ idempotencyKey: string&lt;br&gt;+ status: enum&lt;br&gt;+ amountUSD: decimal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff5ff;strokeColor=#6f98ca;fontColor=#20364f;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1240" y="600" width="330" height="205" as="geometry" /></mxCell><mxCell id="12" value="1 — 0..1 owns" style="endArrow=none;startArrow=none;html=1;rounded=0;strokeColor=#496580;fontSize=13;" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="13" value="1 — 0..* contains" style="endArrow=none;startArrow=none;html=1;rounded=0;strokeColor=#496580;fontSize=13;" edge="1" parent="1" source="5" target="6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="14" value="0..* — 1 product" style="endArrow=none;startArrow=none;html=1;rounded=0;strokeColor=#496580;fontSize=13;" edge="1" parent="1" source="6" target="7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="15" value="1 — 0..* places" style="endArrow=none;startArrow=none;html=1;rounded=0;strokeColor=#496580;fontSize=13;" edge="1" parent="1" source="4" target="8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="16" value="1 — 1..* contains" style="endArrow=none;startArrow=none;html=1;rounded=0;strokeColor=#496580;fontSize=13;" edge="1" parent="1" source="8" target="9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="17" value="0..* — 1 snapshot of" style="endArrow=none;startArrow=none;html=1;rounded=0;strokeColor=#496580;fontSize=13;" edge="1" parent="1" source="9" target="7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="18" value="1 — 0..* holds" style="endArrow=none;startArrow=none;html=1;rounded=0;strokeColor=#496580;fontSize=13;" edge="1" parent="1" source="8" target="10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="19" value="0..* — 1 reserves" style="endArrow=none;startArrow=none;html=1;rounded=0;strokeColor=#496580;fontSize=13;" edge="1" parent="1" source="10" target="7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="20" value="1 — 0..* attempts" style="endArrow=none;startArrow=none;html=1;rounded=0;strokeColor=#496580;fontSize=13;" edge="1" parent="1" source="8" target="11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="21" value="Availability = stockQuantity − sum(active reservations). Reserve atomically at checkout; final payment decrements stock once and completes the reservation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9e8;strokeColor=#dbbc67;fontColor=#6a5420;fontSize=13;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="45" y="970" width="1490" height="95" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="4e31e7c7-" name="03 - UML Order State Machine"><mxGraphModel dx="1300" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1730" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="UML State Machine — Order / Reservation Lifecycle" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#1f3349;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1000" height="44" as="geometry" /></mxCell><mxCell id="3" value="Order payment state and inventory reservation are coordinated, but remain distinct. The 15-minute timer never by itself proves the payment failed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9e8;strokeColor=#dbbc67;fontColor=#6a5420;fontSize=13;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1660" height="58" as="geometry" /></mxCell><mxCell id="4" value="" style="ellipse;html=1;aspect=fixed;fillColor=#34495e;strokeColor=#34495e;" vertex="1" parent="1"><mxGeometry x="75" y="320" width="36" height="36" as="geometry" /></mxCell><mxCell id="5" value="PENDING_PAYMENT&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Active reservation; up to 15 min&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4f0;strokeColor=#6bafa0;fontColor=#203d35;fontSize=15;" vertex="1" parent="1"><mxGeometry x="230" y="265" width="300" height="112" as="geometry" /></mxCell><mxCell id="6" value="PAYMENT_VERIFICATION&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Timeout / delayed callback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2db;strokeColor=#c9a05d;fontSize=16;" vertex="1" parent="1"><mxGeometry x="695" y="270" width="305" height="110" as="geometry" /></mxCell><mxCell id="7" value="PAID&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Stock permanently deducted once&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f4e7;strokeColor=#61aa7c;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1170" y="160" width="300" height="108" as="geometry" /></mxCell><mxCell id="8" value="UNPAID / FAILED ATTEMPT&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;May retry safely if stock can be held&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde9e9;strokeColor=#cf7878;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1160" y="510" width="330" height="120" as="geometry" /></mxCell><mxCell id="9" value="RESERVATION EXPIRED&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Release only when payment not successful&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4ebdf;strokeColor=#be9b73;fontSize=16;" vertex="1" parent="1"><mxGeometry x="690" y="745" width="350" height="120" as="geometry" /></mxCell><mxCell id="10" value="checkout / atomic reserve" style="endArrow=block;html=1;rounded=1;strokeColor=#526478;fontSize=12;" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="11" value="verified Stripe success" style="endArrow=block;html=1;rounded=1;strokeColor=#526478;fontSize=12;" edge="1" parent="1" source="5" target="7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="12" value="verified payment failure" style="endArrow=block;html=1;rounded=1;strokeColor=#526478;fontSize=12;" edge="1" parent="1" source="5" target="8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="13" value="timeout or uncertain status" style="endArrow=block;html=1;rounded=1;strokeColor=#526478;fontSize=12;" edge="1" parent="1" source="5" target="6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="14" value="success confirmed" style="endArrow=block;html=1;rounded=1;strokeColor=#526478;fontSize=12;" edge="1" parent="1" source="6" target="7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="15" value="failure confirmed" style="endArrow=block;html=1;rounded=1;strokeColor=#526478;fontSize=12;" edge="1" parent="1" source="6" target="8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="16" value="expiry and no successful payment" style="endArrow=block;html=1;rounded=1;strokeColor=#526478;fontSize=12;" edge="1" parent="1" source="6" target="9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="17" value="safe retry / new valid reservation" style="endArrow=block;html=1;rounded=1;strokeColor=#526478;fontSize=12;" edge="1" parent="1" source="8" target="5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="18" value="15 min elapsed; no payment in flight" style="endArrow=block;html=1;rounded=1;strokeColor=#526478;fontSize=12;" edge="1" parent="1" source="5" target="9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="19" value="PAID is terminal for v1 purchase processing. Refunds and customer cancellations are outside v1 scope. Repeated callbacks must be idempotent." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9e8;strokeColor=#dbbc67;fontColor=#6a5420;fontSize=13;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="65" y="975" width="1550" height="65" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="f33fb6a3-" name="04 - UML Checkout Activity"><mxGraphModel dx="1300" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1810" pageHeight="1510" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="UML Activity — Checkout and Payment" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#1f3349;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1000" height="44" as="geometry" /></mxCell><mxCell id="3" value="Formalized activity flow. Customer cart is not reserved. Stock is atomically reserved only at checkout; USD is the transaction currency." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9e8;strokeColor=#dbbc67;fontColor=#6a5420;fontSize=13;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="30" y="66" width="1720" height="58" as="geometry" /></mxCell><mxCell id="4" value="" style="ellipse;html=1;fillColor=#2a3e52;strokeColor=#2a3e52;" vertex="1" parent="1"><mxGeometry x="855" y="150" width="30" height="30" as="geometry" /></mxCell><mxCell id="5" value="Customer initiates checkout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4f0;strokeColor=#6bafa0;fontColor=#203d35;fontSize=15;" vertex="1" parent="1"><mxGeometry x="708" y="220" width="330" height="62" as="geometry" /></mxCell><mxCell id="6" value="Validate customer, cart, product status and USD prices" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4f0;strokeColor=#6bafa0;fontColor=#203d35;fontSize=15;" vertex="1" parent="1"><mxGeometry x="665" y="335" width="420" height="62" as="geometry" /></mxCell><mxCell id="7" value="Stock available?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff3df;strokeColor=#d2a25a;fontColor=#5d431e;fontSize=14;" vertex="1" parent="1"><mxGeometry x="810" y="470" width="150" height="90" as="geometry" /></mxCell><mxCell id="8" value="Return insufficient stock error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4f0;strokeColor=#6bafa0;fontColor=#203d35;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1250" y="485" width="330" height="62" as="geometry" /></mxCell><mxCell id="9" value="Atomically reserve inventory for 15 minutes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4f0;strokeColor=#6bafa0;fontColor=#203d35;fontSize=15;" vertex="1" parent="1"><mxGeometry x="655" y="620" width="440" height="62" as="geometry" /></mxCell><mxCell id="10" value="Create pending order + USD item snapshots" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4f0;strokeColor=#6bafa0;fontColor=#203d35;fontSize=15;" vertex="1" parent="1"><mxGeometry x="663" y="730" width="425" height="62" as="geometry" /></mxCell><mxCell id="11" value="Initiate Stripe test payment" style="rounded